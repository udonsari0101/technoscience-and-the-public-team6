# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real values.

APP_ENV=development
APP_NAME=AskPhilo
APP_URL=http://localhost:5000

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Firebase Admin SDK service-account JSON (git-ignored folder)
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# mock | anthropic   — mock never calls the API, even if a key is present
AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional tuning (defaults shown)
# ANTHROPIC_EFFORT=low
# ANTHROPIC_THINKING_HEADROOM_TOKENS=1024
# ANTHROPIC_PROMPT_CACHE=true
# ANTHROPIC_REFUSAL_FALLBACK=true
# ANTHROPIC_SUMMARY_MODEL=
# MOCK_AI_DELAY_MS=500
# CHAT_MESSAGES_PER_MINUTE=12

CONTROLLER_VERSION=v1

MAX_CONTEXT_MESSAGES=10
MAX_OUTPUT_TOKENS=300

SOFT_CONVERSATION_MESSAGE_LIMIT=150
HARD_CONVERSATION_MESSAGE_LIMIT=300

CONTEXT_SUMMARY_TRIGGER_MESSAGES=20
